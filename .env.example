# Supabase project settings: Dashboard → Project Settings → API Keys.
# Both are public. Use the publishable key (sb_publishable_…), never the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Web push: the public half of the VAPID key pair. The private half is an Edge Function secret
# (supabase/functions/daily-push), never set here. Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
